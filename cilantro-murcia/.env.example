# =====================================================================
# Variables de entorno — Cilantro Murcia
# Copia este archivo a `.env` y rellena lo que necesites.
# TODO es OPCIONAL: sin nada, la app funciona con SQLite + Open-Meteo +
# climatología de Murcia + explicaciones de plantilla (sin LLM).
# =====================================================================

# --- Base de datos -----------------------------------------------------
# Por defecto SQLite (cero configuración). Para PostgreSQL/PostGIS:
# DATABASE_URL=postgresql+psycopg://cilantro:cilantro@localhost:5432/cilantro
DATABASE_URL=sqlite:///cilantro.db

# --- LLM (explicaciones en lenguaje natural) ---------------------------
# Si falta, se usan explicaciones deterministas de plantilla.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Meteo local autoritativa (opcional) -------------------------------
# SIAR: calibra la ET0 de Open-Meteo con estaciones reales de Murcia.
#   Solicitar clave en https://servicio.mapa.gob.es/apisiar/
# SIAR_API_KEY=...
# AEMET: avisos oficiales de helada (override).
#   Solicitar clave en https://opendata.aemet.es/
# AEMET_API_KEY=...

# --- Notificaciones push (opcional) ------------------------------------
# Ruta al JSON de credenciales de servicio de Firebase. Sin esto, las
# notificaciones se registran en consola (no se envían a móviles).
# FCM_CREDENTIALS=/ruta/a/firebase-service-account.json
